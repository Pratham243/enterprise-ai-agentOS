# =============================================================================
# Enterprise AI AgentOS — environment variable template
# =============================================================================
# Copy this file to `.env` and fill in real values locally:
#     cp .env.example .env
# `.env` is git-ignored. Never commit real keys or passwords.
# All values below are intentionally empty placeholders.
# =============================================================================

# --- Application --------------------------------------------------------------
APP_ENV=development

# --- Database (future: Step 3 — PostgreSQL) -----------------------------------
DATABASE_URL=

# --- Vector database (future: Step 4 — Pinecone for RAG) ---------------------
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=

# --- LLM providers (future: Step 4+ — RAG & agents) ---------------------------
OPENAI_API_KEY=

# --- Azure OpenAI (alternative to direct OpenAI) -----------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- JWT Authentication (future) ----------------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
